{
  "name": "arides-cargo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "node scripts/prepare-capacitor-web.mjs",
    "android:sync": "npm run build:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && JAVA_HOME=/Users/admin/Library/Java/JavaVirtualMachines/ms-21.0.10/Contents/Home ./gradlew assembleDebug",
    "desktop": "electron .",
    "desktop:mac": "node scripts/package-electron-mac.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/local-notifications": "^7.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@electron/packager": "^20.0.1",
    "electron": "^42.4.1"
  }
}
